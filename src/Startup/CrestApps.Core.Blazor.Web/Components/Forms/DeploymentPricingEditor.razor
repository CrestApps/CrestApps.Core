@using CrestApps.Core.AI.Completions
@using CrestApps.Core.AI.Models
@using CrestApps.Core.Blazor.Web.ViewModels

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="card-title mb-0"><i class="fa-solid fa-coins"></i> Pricing</h6>
        <div class="dropdown">
            <button type="button" class="btn btn-sm btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fa-solid fa-plus"></i> Add price
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                @foreach (var meter in AIUsageMeters.All)
                {
                    <li><button type="button" class="dropdown-item" @onclick="() => AddPrice(meter)">@meter.DisplayName</button></li>
                }
            </ul>
        </div>
    </div>
    <div class="card-body">
        <p class="text-muted small">
            Optional. What this deployment costs with its provider, used to estimate the cost of its usage in the usage reports.
            Add one price per billed unit; a model billed per request and per token gets one of each.
            Cached and audio tokens are taken out of the input and output tokens when they have their own price.
        </p>

        <div class="row g-3 mb-3">
            <div class="col-12 col-md-3">
                <label for="pricingCurrency" class="form-label">Currency</label>
                <input id="pricingCurrency" class="form-control" maxlength="3" placeholder="USD" @bind="Model.PricingCurrency" @bind:event="oninput" />
            </div>
        </div>

        @foreach (var price in Model.Prices)
        {
            var meter = AIUsageMeters.Find(price.Meter) ?? AIUsageMeters.All[0];
            <div class="row g-2 align-items-start mb-2">
                <div class="col-12 col-md-4">
                    <select class="form-select" aria-label="Billed unit" value="@meter.Name" @onchange="args => ChangeMeter(price, args.Value?.ToString())">
                        @foreach (var option in AIUsageMeters.All)
                        {
                            <option value="@option.Name">@option.DisplayName</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-3">
                    <div class="input-group">
                        <span class="input-group-text">@Currency</span>
                        <input type="number" step="any" min="0" class="form-control" aria-label="Price" @bind="price.Amount" />
                    </div>
                </div>
                <div class="col-6 col-md-4">
                    <div class="input-group">
                        <span class="input-group-text">per</span>
                        <select class="form-select" aria-label="Quantity" @bind="price.Per">
                            @foreach (var quantity in meter.Quantities)
                            {
                                <option value="@quantity.Per">@quantity.DisplayName</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-12 col-md-1 text-md-end">
                    <button type="button" class="btn btn-outline-danger" title="Remove this price" aria-label="Remove this price" @onclick="() => Model.Prices.Remove(price)">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                </div>
            </div>
        }

        @if (Model.Prices.Count == 0)
        {
            <div class="text-muted small fst-italic">No prices. Usage of this deployment is reported without a cost.</div>
        }
    </div>
</div>

@code {
    [Parameter]
    [EditorRequired]
    public AIDeploymentViewModel Model { get; set; }

    private string Currency => string.IsNullOrWhiteSpace(Model.PricingCurrency) ? "USD" : Model.PricingCurrency.Trim().ToUpperInvariant();

    private void AddPrice(AIUsageMeterDescriptor meter)
    {
        Model.Prices.Add(new AIDeploymentPrice
        {
            Meter = meter.Name,
            Per = meter.Quantities[0].Per,
        });
    }

    private static void ChangeMeter(AIDeploymentPrice price, string meterName)
    {
        var meter = AIUsageMeters.Find(meterName);

        if (meter is null)
        {
            return;
        }

        price.Meter = meter.Name;

        // Keep the quantity when the new meter is quoted for it too, such as switching between token meters.
        if (!meter.Quantities.Any(quantity => quantity.Per == price.Per))
        {
            price.Per = meter.Quantities[0].Per;
        }
    }
}

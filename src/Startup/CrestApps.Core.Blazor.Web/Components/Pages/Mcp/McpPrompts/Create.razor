@page "/mcp/prompts/create"
@attribute [Authorize(Policy = "Admin")]
@using System.Text.Json
@using CrestApps.Core.AI.Mcp.Models
@using CrestApps.Core.Blazor.Web.ViewModels
@using CrestApps.Core.Services
@using ModelContextProtocol.Protocol
@inject INamedCatalog<McpPrompt> Catalog
@inject IStoreCommitter StoreCommitter
@inject NavigationManager Navigation
@inject TimeProvider TimeProvider

<PageTitle>Create MCP Prompt</PageTitle>

<h2><i class="bi bi-plus-circle"></i> Create MCP Prompt</h2>
<hr />

<EditForm FormName="mcp-mcpprompts-create" Model="_model" OnValidSubmit="HandleSubmitAsync">
    <DataAnnotationsValidator />

    <div class="col-md-8">
        @if (_errors.Count > 0)
        {
            <div class="alert alert-danger">
                @foreach (var error in _errors)
                {
                    <div>@error</div>
                }
            </div>
        }

        <div class="mb-3">
            <label class="form-label">Title</label>
            <InputText @bind-Value="_model.Title" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Technical name</label>
            <InputText @bind-Value="_model.Name" class="form-control" />
            <ValidationMessage For="() => _model.Name" />
            <div class="form-text">Auto-generated from the title. You may override it before saving.</div>
            <div class="form-text">The technical name cannot be changed after creation.</div>
        </div>

        <div class="mb-3">
            <label class="form-label">Description</label>
            <InputTextArea @bind-Value="_model.Description" class="form-control" rows="4" />
        </div>

        <div class="mb-3">
            <label class="form-label">Arguments (JSON array)</label>
            <InputTextArea @bind-Value="_model.Arguments" class="form-control" rows="8" />
            <div class="form-text">Example: <code>[{{ "name": "topic", "description": "Topic to expand", "required": true }}]</code></div>
        </div>

        <div class="mb-3">
            <label class="form-label">Messages (JSON array)</label>
            <InputTextArea @bind-Value="_model.Messages" class="form-control" rows="8" />
            <div class="form-text">Each message has a <code>role</code> (<code>user</code> or <code>assistant</code>) and <code>content</code>. Use <code>{{{{argName}}}}</code> to reference arguments.</div>
            <div class="form-text">Example: <code>[{{ "role": "user", "content": "Summarize {{{{topic}}}}" }}]</code></div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Create</button>
            <a href="/mcp/prompts" class="btn btn-secondary">Cancel</a>
        </div>
    </div>
</EditForm>

@code {
    private static readonly JsonSerializerOptions _indentedJsonOptions = new() { WriteIndented = true };
    private static readonly JsonSerializerOptions _messageJsonOptions = new()
    {
        WriteIndented = true,
        PropertyNameCaseInsensitive = true,
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
    };
    private McpPromptViewModel _model = new();
    private List<string> _errors = [];

    private async Task HandleSubmitAsync()
    {
        _errors.Clear();
        var arguments = ParseArguments(_model);
        var messages = ParseMessages(_model);

        if (_errors.Count > 0)
        {
            return;
        }

        var prompt = new McpPrompt
        {
            ItemId = UniqueId.GenerateId(),
            CreatedUtc = TimeProvider.GetUtcNow().UtcDateTime,
        };

        Apply(_model, prompt, arguments, messages);
        await Catalog.CreateAsync(prompt);
        await StoreCommitter.CommitAsync();
        Navigation.NavigateTo("/mcp/prompts");
    }

    private List<PromptArgument> ParseArguments(McpPromptViewModel model)
    {
        if (string.IsNullOrWhiteSpace(model.Name))
        {
            _errors.Add("Name is required.");
        }

        if (string.IsNullOrWhiteSpace(model.Arguments))
        {
            return [];
        }

        try
        {
            var arguments = JsonSerializer.Deserialize<List<PromptArgument>>(model.Arguments) ?? [];

            for (var i = 0; i < arguments.Count; i++)
            {
                if (string.IsNullOrWhiteSpace(arguments[i].Name))
                {
                    _errors.Add($"Argument {i + 1} requires a name.");
                }
            }

            return arguments.Where(a => !string.IsNullOrWhiteSpace(a.Name)).ToList();
        }
        catch (JsonException)
        {
            _errors.Add("Arguments must be valid JSON.");

            return [];
        }
    }

    private List<McpPromptMessage> ParseMessages(McpPromptViewModel model)
    {
        if (string.IsNullOrWhiteSpace(model.Messages))
        {
            return [];
        }

        try
        {
            var messages = JsonSerializer.Deserialize<List<McpPromptMessage>>(model.Messages, _messageJsonOptions) ?? [];

            for (var i = 0; i < messages.Count; i++)
            {
                if (!IsValidRole(messages[i].Role))
                {
                    _errors.Add($"Message {i + 1} must have a role of 'user' or 'assistant'.");
                }
            }

            return messages.Where(m => !string.IsNullOrWhiteSpace(m.Content)).ToList();
        }
        catch (JsonException)
        {
            _errors.Add("Messages must be valid JSON.");

            return [];
        }
    }

    private static bool IsValidRole(string role)
        => string.Equals(role, "user", StringComparison.OrdinalIgnoreCase)
            || string.Equals(role, "assistant", StringComparison.OrdinalIgnoreCase);

    private static void Apply(McpPromptViewModel model, McpPrompt prompt, List<PromptArgument> arguments, List<McpPromptMessage> messages)
    {
        var name = model.Name.Trim();
        prompt.Name = name;
        prompt.Prompt = new Prompt
        {
            Name = name,
            Title = model.Title?.Trim(),
            Description = model.Description?.Trim(),
            Arguments = arguments,
        };
        prompt.Messages = messages;
    }
}

@page "/ai/deployments"
@attribute [Authorize(Policy = "Admin")]
@using CrestApps.Core.AI.Deployments
@using CrestApps.Core.AI.Models
@using CrestApps.Core.AI.Services
@using CrestApps.Core.Blazor.Web.ViewModels
@using CrestApps.Core.Services
@inject IAIDeploymentStore Store
@inject IStoreCommitter StoreCommitter
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ToastNotificationService ToastNotifications

<PageTitle>AI Deployments - Blazor AI Integration Sample</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="fa-solid fa-box"></i> AI Deployments</h2>
    <a href="/ai/deployments/create" class="btn btn-success">
        <i class="fa-solid fa-plus"></i> Create New Deployment
    </a>
</div>

@if (_deployments == null)
{
    <p><em>Loading...</em></p>
}
else if (_deployments.Count == 0)
{
    <div class="alert alert-info">
        <i class="fa-solid fa-circle-info"></i> No deployments found. Create a deployment to map models to connections.
    </div>
}
else
{
    if (_userDefinedDeployments.Count > 0)
    {
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title mb-0">User-defined deployments</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive mb-0">
                    <table class="table table-striped table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Technical name</th>
                                <th>Model name</th>
                                <th>Capabilities</th>
                                <th>Provider</th>
                                <th>Connection</th>
                                <th style="width: 180px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var deployment in _userDefinedDeployments)
                            {
                                <tr>
                                    <td><strong>@deployment.TechnicalName</strong></td>
                                    <td>@(string.IsNullOrWhiteSpace(deployment.ModelName) ? "—" : deployment.ModelName)</td>
                                    <td>
                                        @if (deployment.SelectedFeatures is null || deployment.SelectedFeatures.Count == 0)
                                        {
                                            <span class="text-muted">&mdash;</span>
                                        }
                                        @foreach (var feature in (deployment.SelectedFeatures ?? []).OrderBy(static name => name, StringComparer.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-secondary me-1">@feature</span>
                                        }
                                        @foreach (var limit in deployment.GetEnforcedLimits())
                                        {
                                            <span class="badge text-bg-warning me-1" title="@limit.Description">
                                                <i class="fa-solid fa-triangle-exclamation"></i> @limit.Label
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@(deployment.ClientName ?? "—")</span>
                                    </td>
                                    <td>@(string.IsNullOrEmpty(deployment.ConnectionName) ? "Standalone" : deployment.ConnectionName)</td>
                                    <td>
                                        <a href="/ai/deployments/edit/@deployment.ItemId" class="btn btn-sm btn-outline-primary">
                                            <i class="fa-solid fa-pencil"></i> Edit
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(deployment.ItemId)">
                                            <i class="fa-solid fa-trash"></i> Delete
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    if (_configuredDeployments.Count > 0)
    {
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">System configuration deployments</h5>
                <span class="badge bg-secondary">Read-only</span>
            </div>
            <div class="card-body">
                <p class="text-muted mb-3">These deployments come from system configuration and cannot be edited or deleted from the UI.</p>
                @if (_limitedConfiguredDeployments.Count > 0)
                {
                    <div class="alert alert-warning">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        A deployment that declares any capability at all is held to that declaration, and these declare one. Anything left out is removed from every request, so the capabilities below are not a description of the model &mdash; they are the whole of what it is allowed to do. Widen the declaration in system configuration; it cannot be corrected here.
                        <ul class="mb-0 mt-2">
                            @foreach (var deployment in _limitedConfiguredDeployments)
                            {
                                <li>
                                    <strong>@deployment.TechnicalName</strong>
                                    @foreach (var limit in deployment.GetEnforcedLimits())
                                    {
                                        <span>&mdash; @limit.Description</span>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                }
                <div class="table-responsive mb-0">
                    <table class="table table-striped table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Technical name</th>
                                <th>Model name</th>
                                <th>Capabilities</th>
                                <th>Provider</th>
                                <th>Connection</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var deployment in _configuredDeployments)
                            {
                                <tr>
                                    <td><strong>@deployment.TechnicalName</strong></td>
                                    <td>@(string.IsNullOrWhiteSpace(deployment.ModelName) ? "—" : deployment.ModelName)</td>
                                    <td>
                                        @if (deployment.SelectedFeatures is null || deployment.SelectedFeatures.Count == 0)
                                        {
                                            <span class="text-muted">&mdash;</span>
                                        }
                                        @foreach (var feature in (deployment.SelectedFeatures ?? []).OrderBy(static name => name, StringComparer.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-secondary me-1">@feature</span>
                                        }
                                        @foreach (var limit in deployment.GetEnforcedLimits())
                                        {
                                            <span class="badge text-bg-warning me-1" title="@limit.Description">
                                                <i class="fa-solid fa-triangle-exclamation"></i> @limit.Label
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@(deployment.ClientName ?? "—")</span>
                                    </td>
                                    <td>@(string.IsNullOrEmpty(deployment.ConnectionName) ? "Standalone" : deployment.ConnectionName)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}

@code {
    private List<AIDeploymentViewModel> _deployments;
    private List<AIDeploymentViewModel> _userDefinedDeployments = [];
    private List<AIDeploymentViewModel> _configuredDeployments = [];
    private List<AIDeploymentViewModel> _limitedConfiguredDeployments = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadDeploymentsAsync();
    }

    private async Task LoadDeploymentsAsync()
    {
        var deployments = await Store.GetAllAsync();

        _deployments = deployments
            .Select(AIDeploymentViewModel.FromDeployment)
            .OrderBy(static model => model.TechnicalName, StringComparer.OrdinalIgnoreCase)
            .ToList();

        _userDefinedDeployments = _deployments.Where(static d => !d.IsReadOnly).ToList();
        _configuredDeployments = _deployments.Where(static d => d.IsReadOnly).ToList();

        // A read-only deployment has no editable capability list, so the screen has to spell out what its
        // declaration costs every request instead of leaving that in a log warning.
        _limitedConfiguredDeployments = _configuredDeployments.Where(static d => d.GetEnforcedLimits().Count > 0).ToList();
    }

    private async Task DeleteAsync(string id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Delete this deployment?");

        if (!confirmed)
        {
            return;
        }

        var deployment = await Store.FindByIdAsync(id);
        if (deployment == null)
        {
            ToastNotifications.ShowError("Deployment not found.");

            return;
        }

        if (deployment.IsReadOnly)
        {
            ToastNotifications.ShowError("Deployments defined in appsettings are read-only and cannot be deleted from the UI.");

            return;
        }

        // Delete through the multi-source store so its scoped merged-entry cache is invalidated before we reload.
        await Store.DeleteAsync(deployment);
        await StoreCommitter.CommitAsync();
        await LoadDeploymentsAsync();
    }
}

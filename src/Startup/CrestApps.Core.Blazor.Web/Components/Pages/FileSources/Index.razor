@page "/filesources"
@attribute [Authorize(Policy = "Admin")]
@using CrestApps.Core.AI.DataSources
@using CrestApps.Core.AI.FileSources
@using CrestApps.Core.AI.Models
@using CrestApps.Core.Services
@using Microsoft.Extensions.Options
@inject ISourceCatalogManager<FileSource> Manager
@inject IFileSourceRunService RunService
@inject IAIDataSourceStore DataSourceStore
@inject IIngestionItemStateStore StateStore
@inject IStoreCommitter StoreCommitter
@inject IOptions<IngestionConnectorOptions> ConnectorOptions
@inject IJSRuntime JS
@inject ToastNotificationService ToastNotifications

<PageTitle>File Sources</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="fa-solid fa-folder-open"></i> File Sources</h2>
    <a href="/filesources/create" class="btn btn-success">
        <i class="fa-solid fa-plus"></i> Create New File Source
    </a>
</div>

@if (_fileSources == null)
{
    <p><em>Loading...</em></p>
}
else if (_fileSources.Count == 0)
{
    <div class="alert alert-info">
        <i class="fa-solid fa-circle-info"></i> No file sources found.
        A file source reads a folder or a file server into a File data source. Create the data source first, under Data Sources.
        <div class="mt-2">
            <a href="/filesources/create" class="btn btn-sm btn-success">
                <i class="fa-solid fa-plus"></i> Create
            </a>
        </div>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Reads from</th>
                    <th>Target data source</th>
                    <th>Enabled</th>
                    <th>Last run</th>
                    <th style="width: 320px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in _fileSources)
                {
                    <tr>
                        <td><strong>@item.DisplayText</strong></td>
                        <td><code>@DescribeSource(item.Source)</code></td>
                        <td>
                            @{
                                var target = DescribeTarget(item.AIDataSourceId);
                            }
                            @if (target is null)
                            {
                                <span class="text-muted">None</span>
                            }
                            else
                            {
                                <span>@target</span>
                            }
                        </td>
                        <td>
                            @if (item.Enabled)
                            {
                                <span class="badge bg-success">Enabled</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Disabled</span>
                            }
                        </td>
                        <td>
                            @{
                                var lastRun = DescribeLastRun(item);
                            }
                            @if (lastRun is null)
                            {
                                <span class="text-muted">Never</span>
                            }
                            else
                            {
                                <span class="small">@lastRun</span>
                            }
                        </td>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-warning" @onclick="() => ResetStateAsync(item.ItemId)">
                                <i class="fa-solid fa-rotate-left"></i> Reset state
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-success" @onclick="() => SyncAsync(item.ItemId)">
                                <i class="fa-solid fa-arrows-rotate"></i> Sync
                            </button>
                            <a href="/filesources/edit/@item.ItemId" class="btn btn-sm btn-outline-primary">
                                <i class="fa-solid fa-pencil"></i> Edit
                            </a>
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(item.ItemId)">
                                <i class="fa-solid fa-trash"></i> Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<FileSource> _fileSources;
    private Dictionary<string, string> _connectorNames = [];
    private Dictionary<string, string> _targets = [];

    protected override async Task OnInitializedAsync()
    {
        // How a connector is labelled comes from what the host registered, never from a list of names
        // written here.
        _connectorNames = ConnectorOptions.Value.Connectors
            .ToDictionary(connector => connector.Name, connector => connector.DisplayName.Value, StringComparer.OrdinalIgnoreCase);

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var dataSources = await DataSourceStore.GetAsync(AIDataSourceSourceTypes.File);

        _targets = dataSources.ToDictionary(dataSource => dataSource.ItemId, dataSource => dataSource.DisplayText, StringComparer.OrdinalIgnoreCase);

        // File sources are their own records in their own store, so nothing has to be filtered out. A
        // record whose connector is no longer registered is still listed, because hiding it would leave an
        // operator with something they cannot see, edit or delete.
        _fileSources = (await Manager.GetAllAsync()).ToList();
    }

    private string DescribeSource(string source)
    {
        return _connectorNames.TryGetValue(source ?? string.Empty, out var displayName) ? displayName : source;
    }

    private string DescribeTarget(string dataSourceId)
    {
        if (string.IsNullOrEmpty(dataSourceId))
        {
            return null;
        }

        return _targets.TryGetValue(dataSourceId, out var displayText) ? displayText : dataSourceId;
    }

    private static string DescribeLastRun(FileSource fileSource)
    {
        if (!fileSource.TryGet<FileSourceRunSummary>(out var lastRun))
        {
            return null;
        }

        var note = lastRun.DiscoveryCompleted ? string.Empty : " (partial listing)";

        return $"{lastRun.Status} — {lastRun.ItemsIndexed} indexed, {lastRun.ItemsDeleted} removed{note}";
    }

    private async Task ResetStateAsync(string id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Forget what this file source has read? The next run re-reads every file.");

        if (!confirmed)
        {
            return;
        }

        // Forgetting what was read, not what was stored.
        await StateStore.DeleteBySourceIdAsync(id);
        await StoreCommitter.CommitAsync();

        ToastNotifications.ShowSuccess("File source state cleared. The next run will re-read every file.");
    }

    private async Task SyncAsync(string id)
    {
        var fileSource = await Manager.FindByIdAsync(id);

        if (fileSource == null)
        {
            ToastNotifications.ShowError("File source not found.");

            return;
        }

        var run = await RunService.RunAsync(fileSource);

        // The run service records its progress through the transactional store; an interactive circuit has
        // no request filter to flush it, so commit explicitly (the Delete handler below does the same).
        await StoreCommitter.CommitAsync();

        if (run.Status == FileSourceRunStatus.Failed)
        {
            ToastNotifications.ShowError(run.Error);
        }
        else
        {
            var note = run.DiscoveryCompleted ? string.Empty : " The source was only partly listed, so nothing was removed.";

            ToastNotifications.ShowSuccess(
                $"File source run finished: {run.ItemsIndexed} indexed, {run.ItemsSkipped} unchanged, {run.ItemsDeleted} removed, {run.ItemsFailed} failed.{note}");
        }

        await LoadAsync();
    }

    private async Task DeleteAsync(string id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Delete this file source?");

        if (!confirmed)
        {
            return;
        }

        var fileSource = await Manager.FindByIdAsync(id);

        if (fileSource == null)
        {
            ToastNotifications.ShowError("File source not found.");

            return;
        }

        await Manager.DeleteAsync(fileSource);
        await StoreCommitter.CommitAsync();
        ToastNotifications.ShowSuccess("File source deleted successfully. Knowledge-base cleanup has been queued.");
        await LoadAsync();
    }
}

@using System.Text.Json
@using CrestApps.Core.AI.WebMcp
@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @if (AntiforgeryToken is not null)
    {
        <meta name="RequestVerificationToken" content="@AntiforgeryToken" />
    }
    <title>@(PageTitle ?? "Blazor AI Integration Sample")</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@crestapps/bootstrap-select@1.2.3/dist/css/bootstrap-select.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@fortawesome/fontawesome-free@@7/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@crestapps/bootstrap-select@@1.2.1/dist/css/bootstrap-select.min.css" />
    <link rel="stylesheet" href="/css/site.css" />
    <link rel="stylesheet" href="/_content/CrestApps.AI.Resources/styles/chat-image-carousel.css?v=@AssetVersion" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <HeadOutlet @rendermode="@InteractiveRenderMode" />
</head>
<body>
    <Routes @rendermode="@InteractiveRenderMode" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@crestapps/bootstrap-select@@1.2.3/dist/js/bootstrap-select.min.js"></script>
    <script src="/js/bootstrap-select-interop.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@@10.0.11/dist/browser/signalr.min.js"
            integrity="sha384-N+pL/4qXZHZcvsa6hVMd5/7cdF3lC59ZMNHeQyRo5q9jmC7yw0hcJILPjUDSU7ZS"
            crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/vue@3/dist/vue.global.prod.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/dompurify@3/dist/purify.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/highlight.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
    <script src="/_content/CrestApps.AI.Resources/scripts/document-drop-zone.js?v=@AssetVersion"></script>
    <script src="/_content/CrestApps.AI.Resources/scripts/technical-name-generator.js?v=@AssetVersion"></script>
    <script src="/_content/CrestApps.AI.Resources/scripts/realtime-audio.js?v=@AssetVersion"></script>
    <script src="/_content/CrestApps.AI.Resources/scripts/chat-markers.js?v=@AssetVersion"></script>
    <script src="/_content/CrestApps.AI.Resources/scripts/chat-image-carousel.js?v=@AssetVersion"></script>
    @if (WebMcpConfiguration is not null)
    {
        @* WebMCP for signed-in users: the standard document.modelContext (native or polyfilled), the AI tools selected
           in the settings, the page tools, and the WebMCP playground's fake store tools, which its page starts. *@
        <script type="application/json" id="@WebMcpConstants.ConfigurationElementId">@((MarkupString)WebMcpConfiguration)</script>
        <script src="/_content/CrestApps.AI.WebMcp.Resources/scripts/webmcp-polyfill.js?v=@AssetVersion"></script>
        <script src="/_content/CrestApps.AI.WebMcp.Resources/scripts/webmcp.js?v=@AssetVersion"></script>
        <script src="/_content/CrestApps.AI.WebMcp.Resources/scripts/webmcp-page-tools.js?v=@AssetVersion"></script>
        <script src="/js/webmcp-playground.js?v=@AssetVersion"></script>
        <script src="/js/agui-playground.js?v=@AssetVersion"></script>
    }
    <script src="/_content/CrestApps.AI.Resources/scripts/ai-chat.js?v=@AssetVersion"></script>
    <script src="/_content/CrestApps.AI.Resources/scripts/ai-chat-widget.js?v=@AssetVersion"></script>
    <script src="/_content/CrestApps.AI.Resources/scripts/chat-interaction.js?v=@AssetVersion"></script>
    <script src="/_content/CrestApps.AI.Resources/scripts/chat-interaction-settings.js?v=@AssetVersion"></script>
    <script src="/_framework/blazor.web.js"></script>
    <script>
        window.renderMarkdownArticle = function (markdown) {
            var container = document.getElementById("article-content");
            if (container && typeof marked !== "undefined" && typeof DOMPurify !== "undefined") {
                var html = marked.parse(markdown || "");
                container.innerHTML = DOMPurify.sanitize(html);
            }
        };
    </script>
</body>
</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; }

    private string PageTitle => HttpContext?.Items["PageTitle"] as string;

    // The token the chat scripts send with the document uploads and removals, which validate it for a signed-in user.
    private string AntiforgeryToken => HttpContext is null ? null : Antiforgery.GetAndStoreTokens(HttpContext).RequestToken;

    private string WebMcpConfiguration
    {
        get
        {
            if (HttpContext?.User?.Identity?.IsAuthenticated != true)
            {
                return null;
            }

            var tokens = Antiforgery.GetAndStoreTokens(HttpContext);

            return JsonSerializer.Serialize(new Dictionary<string, object>
            {
                ["toolsUrl"] = $"/{WebMcpConstants.DefaultRoutePrefix}/tools",
                ["invokeUrlTemplate"] = $"/{WebMcpConstants.DefaultRoutePrefix}/tools/{{name}}/invoke",
                ["antiforgeryHeaderName"] = tokens.HeaderName,
                ["antiforgeryToken"] = tokens.RequestToken,
                ["isAdmin"] = HttpContext.Request.Path.StartsWithSegments("/admin", StringComparison.OrdinalIgnoreCase),
            });
        }
    }

    // Cache-busting token for mutable local scripts (e.g. ai-chat.js). Computed once per process, so
    // browsers cache within a run but always re-fetch after a redeploy/restart that ships new script content.
    private static readonly string AssetVersion = DateTime.UtcNow.Ticks.ToString();

    // Disable prerendering so EditForm submissions never fall back to a static SSR POST,
    // which would require a FormName on every form. Interactive Server handles submission
    // through the SignalR circuit instead.
    private static readonly InteractiveServerRenderMode InteractiveRenderMode = new(prerender: false);
}

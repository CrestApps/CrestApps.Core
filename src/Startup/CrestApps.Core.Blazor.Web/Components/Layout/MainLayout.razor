@inherits LayoutComponentBase
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">
            <i class="fa-solid fa-robot"></i> Blazor AI Integration Sample
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" href="/">
                        <i class="fa-solid fa-house"></i> Home
                    </a>
                </li>
            </ul>
            <ul class="navbar-nav">
                <AuthorizeView>
                    <Authorized>
                        <li class="nav-item">
                            <span class="nav-link text-light">
                                <i class="fa-solid fa-circle-user"></i> @context.User.Identity?.Name
                            </span>
                        </li>
                        <li class="nav-item">
                            <form method="post" action="/Account/Logout">
                                <AntiforgeryToken />
                                <button type="submit" class="nav-link btn btn-link text-light">
                                    <i class="fa-solid fa-right-from-bracket"></i> Logout
                                </button>
                            </form>
                        </li>
                    </Authorized>
                    <NotAuthorized>
                        <li class="nav-item">
                            <a class="nav-link" href="/account/login">
                                <i class="fa-solid fa-right-to-bracket"></i> Login
                            </a>
                        </li>
                    </NotAuthorized>
                </AuthorizeView>
            </ul>
        </div>
    </div>
</nav>

<div class="d-flex app-layout">
    <AuthorizeView Roles="Administrator">
        <Authorized>
            <NavMenu />
        </Authorized>
    </AuthorizeView>

    <main class="flex-grow-1 p-4 app-content">
        @Body
    </main>
</div>

<ToastContainer />

<ChatWidget />

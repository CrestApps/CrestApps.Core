@using CrestApps.Core.AI.Models
@using CrestApps.Core.Mvc.Web.Areas.AI.ViewModels
@model IReadOnlyCollection<AIDeploymentViewModel>
@{
    ViewData["Title"] = "AI Deployments";
    var userDefinedDeployments = Model.Where(static deployment => !deployment.IsReadOnly).ToList();
    var configuredDeployments = Model.Where(static deployment => deployment.IsReadOnly).ToList();
    // A read-only deployment has no editable capability list, so the screen has to spell out what its
    // declaration costs every request instead of leaving that in a log warning.
    var limitedConfiguredDeployments = configuredDeployments.Where(static deployment => deployment.GetEnforcedLimits().Count > 0).ToList();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="fa-solid fa-box"></i> AI Deployments</h2>
    <a asp-action="Create" class="btn btn-success">
        <i class="fa-solid fa-plus"></i> Create New Deployment
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="fa-solid fa-circle-info"></i> No deployments found. Create a deployment to map models to connections.
    </div>
}
else
{
    @if (userDefinedDeployments.Count > 0)
    {
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title mb-0">User-defined deployments</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive mb-0">
                    <table class="table table-striped table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Technical name</th>
                                <th>Model name</th>
                                <th>Capabilities</th>
                                <th>Provider</th>
                                <th>Connection</th>
                                <th style="width: 180px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var deployment in userDefinedDeployments)
                            {
                                <tr>
                                    <td><strong>@deployment.TechnicalName</strong></td>
                                    <td>@(string.IsNullOrWhiteSpace(deployment.ModelName) ? "—" : deployment.ModelName)</td>
                                    <td>
                                        @if (deployment.SelectedFeatures is null || deployment.SelectedFeatures.Length == 0)
                                        {
                                            <span class="text-muted">&mdash;</span>
                                        }
                                        else
                                        {
                                            foreach (var feature in deployment.SelectedFeatures.OrderBy(static name => name, StringComparer.OrdinalIgnoreCase))
                                            {
                                                <span class="badge bg-secondary me-1">@feature</span>
                                            }
                                        }
                                        @foreach (var limit in deployment.GetEnforcedLimits())
                                        {
                                            <span class="badge text-bg-warning me-1" title="@limit.Description">
                                                <i class="fa-solid fa-triangle-exclamation"></i> @limit.Label
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@(deployment.ClientName ?? "—")</span>
                                    </td>
                                    <td>@(string.IsNullOrEmpty(deployment.ConnectionName) ? "Standalone" : deployment.ConnectionName)</td>
                                    <td>
                                        <a asp-action="Edit" asp-route-id="@deployment.ItemId" class="btn btn-sm btn-outline-primary">
                                            <i class="fa-solid fa-pencil"></i> Edit
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@deployment.ItemId" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this deployment?')">
                                                <i class="fa-solid fa-trash"></i> Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @if (configuredDeployments.Count > 0)
    {
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">System configuration deployments</h5>
                <span class="badge bg-secondary">Read-only</span>
            </div>
            <div class="card-body">
                <p class="text-muted mb-3">These deployments come from system configuration and cannot be edited or deleted from the UI.</p>
                @if (limitedConfiguredDeployments.Count > 0)
                {
                    <div class="alert alert-warning">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        A deployment that declares any capability at all is held to that declaration, and these declare one. Anything left out is removed from every request, so the capabilities below are not a description of the model &mdash; they are the whole of what it is allowed to do. Widen the declaration in system configuration; it cannot be corrected here.
                        <ul class="mb-0 mt-2">
                            @foreach (var deployment in limitedConfiguredDeployments)
                            {
                                <li>
                                    <strong>@deployment.TechnicalName</strong>
                                    @foreach (var limit in deployment.GetEnforcedLimits())
                                    {
                                        <span>&mdash; @limit.Description</span>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                }
                <div class="table-responsive mb-0">
                    <table class="table table-striped table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Technical name</th>
                                <th>Model name</th>
                                <th>Capabilities</th>
                                <th>Provider</th>
                                <th>Connection</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var deployment in configuredDeployments)
                            {
                                <tr>
                                    <td><strong>@deployment.TechnicalName</strong></td>
                                    <td>@(string.IsNullOrWhiteSpace(deployment.ModelName) ? "—" : deployment.ModelName)</td>
                                    <td>
                                        @if (deployment.SelectedFeatures is null || deployment.SelectedFeatures.Length == 0)
                                        {
                                            <span class="text-muted">&mdash;</span>
                                        }
                                        else
                                        {
                                            foreach (var feature in deployment.SelectedFeatures.OrderBy(static name => name, StringComparer.OrdinalIgnoreCase))
                                            {
                                                <span class="badge bg-secondary me-1">@feature</span>
                                            }
                                        }
                                        @foreach (var limit in deployment.GetEnforcedLimits())
                                        {
                                            <span class="badge text-bg-warning me-1" title="@limit.Description">
                                                <i class="fa-solid fa-triangle-exclamation"></i> @limit.Label
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@(deployment.ClientName ?? "—")</span>
                                    </td>
                                    <td>@(string.IsNullOrEmpty(deployment.ConnectionName) ? "Standalone" : deployment.ConnectionName)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}

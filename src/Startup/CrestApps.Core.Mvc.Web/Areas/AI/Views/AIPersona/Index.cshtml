@model IEnumerable<CrestApps.Core.Mvc.Web.Areas.AI.ViewModels.AIPersonaViewModel>
@{
    ViewData["Title"] = "Personas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="fa-solid fa-masks-theater"></i> Personas</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fa-solid fa-plus"></i> New Persona
    </a>
</div>

<p class="text-muted">
    A persona is a reusable character: who the assistant is, how it talks, the name it uses and the voice it speaks with.
    AI profiles and chat interactions link to a persona, so an edit here applies to all of them from their next message.
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="fa-solid fa-circle-info"></i> No personas yet.
        <a asp-action="Create">Create your first persona</a>.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Technical Name</th>
                    <th>Assistant Name</th>
                    <th>Voice</th>
                    <th>Stored In</th>
                    <th style="min-width: 190px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var persona in Model)
                {
                    var editId = persona.IsFromFile ? persona.Name : persona.ItemId;
                    <tr>
                        <td>
                            <a asp-action="Edit" asp-route-id="@editId" class="text-decoration-none fw-semibold">
                                @(persona.DisplayText ?? persona.Name)
                            </a>
                        </td>
                        <td><code>@persona.Name</code></td>
                        <td>@(persona.AssistantName ?? "—")</td>
                        <td>@(persona.VoiceName ?? "—")</td>
                        <td>
                            @if (persona.IsFromFile)
                            {
                                <span class="badge bg-secondary" title="Saving it creates a saved persona with the same name, which replaces the file.">File</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Saved</span>
                            }
                        </td>
                        <td class="text-nowrap">
                            <div class="d-inline-flex flex-nowrap gap-2">
                                <a asp-action="Edit" asp-route-id="@editId" class="btn btn-sm btn-outline-primary">
                                    <i class="fa-solid fa-pencil"></i> Edit
                                </a>
                                @if (!persona.IsFromFile)
                                {
                                    <form asp-action="Delete" asp-route-id="@persona.ItemId" method="post" class="d-inline"
                                          onsubmit="return confirm('Delete this persona? Profiles and interactions that use it carry on without one.');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="fa-solid fa-trash"></i> Delete
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

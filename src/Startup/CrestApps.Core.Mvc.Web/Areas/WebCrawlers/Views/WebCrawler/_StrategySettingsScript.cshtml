<script>
    (() => {
        const strategyField = document.getElementById('Source');

        const toggle = (id, visible) => {
            const element = document.getElementById(id);
            if (!element) {
                return;
            }

            element.hidden = !visible;
        };

        const updateVisibility = () => {
            const strategy = strategyField ? strategyField.value : '';

            toggle('sitemap-strategy-settings', strategy === 'Sitemap');

            // A settings card names the sources it belongs to, space separated, and is shown for
            // those only. Without this every connector's card renders on every crawler's form.
            const sections = document.querySelectorAll('[data-source-section]');

            for (const section of sections) {
                const sources = (section.getAttribute('data-source-section') || '')
                    .split(/\s+/)
                    .filter(value => value.length > 0);

                section.hidden = sources.indexOf(strategy) === -1;
            }
        };

        if (strategyField) {
            strategyField.addEventListener('change', updateVisibility);
        }

        updateVisibility();
    })();
</script>

@model IReadOnlyCollection<CrestApps.Core.AI.Models.AIDataSource>
@{
    ViewData["Title"] = "Data Sources";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="fa-solid fa-layer-group"></i> Data Sources</h2>
    <a asp-action="Create" class="btn btn-success">
        <i class="fa-solid fa-plus"></i> Create New Data Source
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="fa-solid fa-circle-info"></i> No data sources found.
        Create one to map data from an existing search index into a knowledge base.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Source Index</th>
                    <th>Knowledge Base Index</th>
                    <th>Last sync</th>
                    <th style="width: 250px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    @* A sync that failed leaves a data source that looks perfectly normal and holds nothing,
                       so the row itself carries the failure rather than only the badge. *@
                    var hasLastSync = item.TryGet<CrestApps.Core.AI.Models.AIDataSourceSyncSummary>(out var lastSync);
                    var syncFailed = hasLastSync && lastSync.Status != CrestApps.Core.AI.Models.AIDataSourceSyncStatus.Succeeded;

                    <tr class="@(syncFailed ? "table-danger" : null)">
                        <td><strong>@item.DisplayText</strong></td>
                        <td><code>@(item.SourceIndexProfileName ?? "—")</code></td>
                        <td><code>@(item.AIKnowledgeBaseIndexProfileName ?? "—")</code></td>
                        <td>
                            @if (!hasLastSync)
                            {
                                <span class="text-muted">Never</span>
                            }
                            else
                            {
                                <span class="badge @(syncFailed ? "bg-danger" : "bg-success")">@lastSync.Status</span>
                                <div class="small text-muted">
                                    @lastSync.CompletedUtc.ToString("u") &mdash; @lastSync.DocumentsIndexed indexed
                                </div>

                                if (syncFailed)
                                {
                                    <div class="small text-danger">@lastSync.Error</div>
                                }
                            }
                        </td>
                        <td>
                            <form asp-action="Sync" asp-route-id="@item.ItemId"
                                  method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-success">
                                    <i class="fa-solid fa-arrows-rotate"></i> Sync
                                </button>
                            </form>
                            @if (string.Equals(item.Source, CrestApps.Core.AI.Models.AIDataSourceSourceTypes.File, StringComparison.OrdinalIgnoreCase))
                            {
                                <a href="/FileSources/FileSource/Index"
                                   class="btn btn-sm btn-outline-info">
                                    <i class="fa-solid fa-folder-open"></i> File sources
                                </a>
                            }
                            <a asp-action="Edit" asp-route-id="@item.ItemId"
                               class="btn btn-sm btn-outline-primary">
                                <i class="fa-solid fa-pencil"></i> Edit
                            </a>
                            <form asp-action="Delete" asp-route-id="@item.ItemId"
                                  method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('Delete this data source?')">
                                    <i class="fa-solid fa-trash"></i> Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

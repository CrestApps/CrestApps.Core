@using CrestApps.Core.AI.Ingestion
@using CrestApps.Core.AI.FileSources.Connectors
@using CrestApps.Core.AI.Ftp
@using CrestApps.Core.AI.Sftp
@using CrestApps.Core.Mvc.Web.Areas.FileSources.ViewModels
@model FileSourceViewModel

@* Each card names the connectors it belongs to and is hidden server-side for the rest, so a validation
   redisplay never flashes another connector's settings before the toggle script runs. *@
<div class="card mb-3" data-source-section="@FileSystemIngestionConnector.ConnectorName"@(Model.IsFileSystem ? null : " hidden")>
    <div class="card-header">Folder</div>
    <div class="card-body">
        <div class="mb-3">
            <label asp-for="LocalRootPath" class="form-label">Folder</label>
            <input asp-for="LocalRootPath" class="form-control font-monospace" placeholder="D:\knowledge" />
            <span asp-validation-for="LocalRootPath" class="text-danger"></span>
            <div class="form-text">Must sit inside a folder the application is configured to read. Ask an administrator to add it to the allowed roots otherwise.</div>
        </div>
        <div class="mb-3 form-check">
            <input asp-for="LocalRecursive" class="form-check-input" type="checkbox" />
            <label asp-for="LocalRecursive" class="form-check-label">Include sub-folders</label>
        </div>
    </div>
</div>

<div class="card mb-3" data-source-section="@FtpIngestionConnector.ConnectorName @SftpIngestionConnector.ConnectorName"@(Model.IsFtp || Model.IsSftp ? null : " hidden")>
    <div class="card-header">Connection</div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-8 mb-3">
                <label asp-for="RemoteHost" class="form-label">Host</label>
                <input asp-for="RemoteHost" class="form-control" placeholder="files.example.com" />
                <span asp-validation-for="RemoteHost" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="RemotePort" class="form-label">Port</label>
                <input asp-for="RemotePort" class="form-control" type="number" min="1" />
                <div class="form-text">Leave empty for 21 on FTP and 22 on SFTP.</div>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="RemoteUsername" class="form-label">Username</label>
            <input asp-for="RemoteUsername" class="form-control" autocomplete="off" />
            <span asp-validation-for="RemoteUsername" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="RemotePassword" class="form-label">Password</label>
            <input asp-for="RemotePassword" class="form-control" type="password" autocomplete="new-password" />
            <span asp-validation-for="RemotePassword" class="text-danger"></span>
            @if (Model.RemoteHasPassword)
            {
                <div class="form-text">Leave blank to keep the existing password.</div>
            }
        </div>
    </div>
</div>

<div class="card mb-3" data-source-section="@FtpIngestionConnector.ConnectorName"@(Model.IsFtp ? null : " hidden")>
    <div class="card-header">FTP transport</div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="FtpEncryptionMode" class="form-label">Encryption mode</label>
                <input asp-for="FtpEncryptionMode" class="form-control" placeholder="None / Explicit / Implicit / Auto" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="FtpDataConnectionType" class="form-label">Data connection type</label>
                <input asp-for="FtpDataConnectionType" class="form-control" placeholder="AutoPassive / PASV / EPSV / PORT" />
            </div>
        </div>
        <div class="form-check form-switch">
            <input asp-for="FtpValidateAnyCertificate" class="form-check-input" type="checkbox" />
            <label asp-for="FtpValidateAnyCertificate" class="form-check-label">Accept any SSL/TLS certificate</label>
            <div class="form-text">Turns off certificate validation for this file source. Use it only against a server you control.</div>
        </div>
    </div>
</div>

<div class="card mb-3" data-source-section="@SftpIngestionConnector.ConnectorName"@(Model.IsSftp ? null : " hidden")>
    <div class="card-header">SFTP key</div>
    <div class="card-body">
        <div class="mb-3">
            <label asp-for="SftpPrivateKey" class="form-label">Private key (PEM)</label>
            <textarea asp-for="SftpPrivateKey" class="form-control font-monospace" rows="5" autocomplete="off"></textarea>
            <div class="form-text">Either a password or a private key is required.</div>
            @if (Model.SftpHasPrivateKey)
            {
                <div class="form-text">Leave blank to keep the existing private key.</div>
            }
        </div>
        <div class="mb-3">
            <label asp-for="SftpPassphrase" class="form-label">Passphrase</label>
            <input asp-for="SftpPassphrase" class="form-control" type="password" autocomplete="new-password" />
            <div class="form-text">Only needed when the private key is encrypted.</div>
            @if (Model.SftpHasPassphrase)
            {
                <div class="form-text">Leave blank to keep the existing passphrase.</div>
            }
        </div>
    </div>
</div>

<div class="card mb-3" data-source-section="@FtpIngestionConnector.ConnectorName @SftpIngestionConnector.ConnectorName"@(Model.IsFtp || Model.IsSftp ? null : " hidden")>
    <div class="card-header">Remote folder</div>
    <div class="card-body">
        <div class="mb-3">
            <label asp-for="RemoteRootPath" class="form-label">Folder on the server</label>
            <input asp-for="RemoteRootPath" class="form-control font-monospace" placeholder="/" />
            <span asp-validation-for="RemoteRootPath" class="text-danger"></span>
        </div>
        <div class="form-check">
            <input asp-for="RemoteRecursive" class="form-check-input" type="checkbox" />
            <label asp-for="RemoteRecursive" class="form-check-label">Include sub-folders</label>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">Ingestion</div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="FigureMode" class="form-label">Figures</label>
                <select asp-for="FigureMode" class="form-select" asp-items="Html.GetEnumSelectList<FigureProcessingMode>()"></select>
                <div class="form-text">How far figure enrichment is taken. <strong>Off</strong> is how figure transcription is disabled; leaving a deployment unset never disables it.</div>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="MaxFigureDescriptionsPerDocument" class="form-label">Figures transcribed per document</label>
                <input asp-for="MaxFigureDescriptionsPerDocument" class="form-control" type="number" min="0" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="VisionDeploymentName" class="form-label">Vision deployment</label>
                <select asp-for="VisionDeploymentName" asp-items="Model.VisionDeployments" class="form-select"></select>
                <span asp-validation-for="VisionDeploymentName" class="text-danger"></span>
                <div class="form-text">Must accept image input. Saving one that cannot read a picture is refused.</div>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="UtilityDeploymentName" class="form-label">Utility deployment</label>
                <select asp-for="UtilityDeploymentName" asp-items="Model.UtilityDeployments" class="form-select"></select>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="MaxItemsPerRun" class="form-label">Files per run</label>
                <input asp-for="MaxItemsPerRun" class="form-control" type="number" min="1" placeholder="Application default" />
                <div class="form-text">What is left over is picked up by the next run. Nothing is removed because a run did not reach it.</div>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Language" class="form-label">Language</label>
                <input asp-for="Language" class="form-control" placeholder="e.g., en, hu" />
                <div class="form-text">Optional. Set it only when the whole corpus is in one language.</div>
            </div>
        </div>
    </div>
</div>

@if (Model.LastRun is not null)
{
    <div class="card mb-3">
        <div class="card-header">Last run</div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.LastRun.Status</dd>
                <dt class="col-sm-3">Started</dt>
                <dd class="col-sm-9">@Model.LastRun.StartedUtc.ToString("u")</dd>
                <dt class="col-sm-3">Files</dt>
                <dd class="col-sm-9">
                    @Model.LastRun.ItemsDiscovered seen, @Model.LastRun.ItemsIndexed indexed,
                    @Model.LastRun.ItemsSkipped unchanged, @Model.LastRun.ItemsDeleted removed,
                    @Model.LastRun.ItemsFailed failed
                </dd>
                <dt class="col-sm-3">Figures</dt>
                <dd class="col-sm-9">@Model.LastRun.FiguresDiscovered stored, @Model.LastRun.FiguresPendingDescription awaiting transcription</dd>
                <dt class="col-sm-3">Listing</dt>
                <dd class="col-sm-9">
                    @if (Model.LastRun.DiscoveryCompleted)
                    {
                        <span class="text-success">Complete</span>
                    }
                    else
                    {
                        <span class="text-warning">Partial &mdash; nothing was removed</span>
                    }
                </dd>
                @if (!string.IsNullOrWhiteSpace(Model.LastRun.Error))
                {
                    <dt class="col-sm-3">Note</dt>
                    <dd class="col-sm-9">@Model.LastRun.Error</dd>
                }
            </dl>
        </div>
    </div>
}

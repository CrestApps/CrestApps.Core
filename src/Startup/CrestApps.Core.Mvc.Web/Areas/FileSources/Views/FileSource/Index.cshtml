@model IReadOnlyCollection<CrestApps.Core.AI.Models.FileSource>
@{
    ViewData["Title"] = "File Sources";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="fa-solid fa-folder-open"></i> File Sources</h2>
    <a asp-action="Create" class="btn btn-success">
        <i class="fa-solid fa-plus"></i> Create New File Source
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="fa-solid fa-circle-info"></i> No file sources found.
        Create one to read a folder or a file server into a File data source.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Reads from</th>
                    <th>Enabled</th>
                    <th>Last run</th>
                    <th style="width: 320px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.DisplayText</strong></td>
                        <td><code>@item.Source</code></td>
                        <td>
                            @if (item.Enabled)
                            {
                                <span class="badge bg-success">Enabled</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Disabled</span>
                            }
                        </td>
                        <td>
                            @if (item.TryGet<CrestApps.Core.AI.FileSources.FileSourceRunSummary>(out var lastRun))
                            {
                                <span class="badge @(lastRun.Status == CrestApps.Core.AI.FileSources.FileSourceRunStatus.Succeeded ? "bg-success" : lastRun.Status == CrestApps.Core.AI.FileSources.FileSourceRunStatus.Failed ? "bg-danger" : "bg-warning text-dark")">@lastRun.Status</span>
                                <div class="small text-muted">
                                    @lastRun.StartedUtc.ToString("u") &mdash; @lastRun.ItemsIndexed indexed, @lastRun.ItemsDeleted removed
                                    @if (!lastRun.DiscoveryCompleted)
                                    {
                                        <text>(partial listing)</text>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">Never</span>
                            }
                        </td>
                        <td>
                            <form asp-action="Sync" asp-route-id="@item.ItemId"
                                  method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-success">
                                    <i class="fa-solid fa-arrows-rotate"></i> Sync
                                </button>
                            </form>
                            <form asp-action="ResetState" asp-route-id="@item.ItemId"
                                  method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-warning"
                                        onclick="return confirm('Forget what this file source has read? The next run re-reads every file.')">
                                    <i class="fa-solid fa-rotate-left"></i> Reset state
                                </button>
                            </form>
                            <a asp-action="Edit" asp-route-id="@item.ItemId"
                               class="btn btn-sm btn-outline-primary">
                                <i class="fa-solid fa-pencil"></i> Edit
                            </a>
                            <form asp-action="Delete" asp-route-id="@item.ItemId"
                                  method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('Delete this file source?')">
                                    <i class="fa-solid fa-trash"></i> Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

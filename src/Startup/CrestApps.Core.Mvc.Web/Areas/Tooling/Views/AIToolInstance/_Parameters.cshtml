                    <div class="form-check">
                        <input type="checkbox" name="Parameters[__index__].Required" value="true" class="form-check-input param-required" />
                        <input type="hidden" name="Parameters[__index__].Required" value="false" />
                        <label class="form-check-label small">Required</label>
                    </div>
                </div>
                <div class="col-12">
                    <label class="form-label small mb-1">Allowed values</label>
                    <input name="Parameters[__index__].AllowedValues" class="form-control form-control-sm" placeholder="open, closed, cancelled" />
                    <div class="form-text">Optional, comma separated. Leave blank to accept any value of the selected type.</div>
                </div>
            </div>

            <div class="row g-2 mt-1 fill-fixed">
                <div class="col-12 col-xl-8">
                    <label class="form-label small mb-1">Value <span class="text-danger">*</span></label>
                    <input name="Parameters[__index__].FixedValue" class="form-control form-control-sm param-fixed-value" autocomplete="new-password" />
                </div>
                <div class="col-12 col-xl-4 d-flex align-items-center pt-3">
                    <div class="form-check">
                        <input type="checkbox" name="Parameters[__index__].IsSecret" value="true" class="form-check-input param-secret" />
                        <input type="hidden" name="Parameters[__index__].IsSecret" value="false" />
                        <label class="form-check-label small">Treat as secret</label>
                    </div>
                </div>
            </div>

            <div class="row g-2 mt-1 fill-context">
                <div class="col-12 col-xl-8">
                    <label class="form-label small mb-1">Context key <span class="text-danger">*</span></label>
                    <select name="Parameters[__index__].ContextKey" class="form-select form-select-sm param-context">
                        <option value="">Choose…</option>
                        @foreach (var key in contextKeys)
                        {
                            <option value="@key.Key" title="@key.Description">@key.DisplayName</option>
                        }
                    </select>
                    <div class="form-text">Resolved on the server for every call. The model never sees or supplies this value.</div>

                        <label class="form-label small mb-1">Target name</label>
                        <input name="Parameters[__index__].BindingName" class="form-control form-control-sm font-monospace param-binding-name" />
                        <div class="form-text">The query key, header name, path token, or dotted body path. Defaults to the parameter name.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</template>

<script src="~/js/tool-instance-parameters.js" asp-append-version="true"></script>

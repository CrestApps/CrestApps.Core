@model IReadOnlyList<CrestApps.Core.AI.Models.AIDeployment>
@{
    ViewData["Title"] = "Realtime model test";
}

<div class="d-flex align-items-center mb-3">
    <i class="bi bi-mic fs-2 text-primary me-3"></i>
    <div>
        <h3 class="mb-0">Realtime model test</h3>
        <div class="text-muted">Speech-to-speech test harness for the realtime client (OpenAI / Azure OpenAI).</div>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle"></i>
        No <strong>Realtime</strong> deployments found. Create an
        <a asp-area="AI" asp-controller="AIDeployment" asp-action="Index">AI deployment</a> whose purpose includes
        <strong>Realtime</strong>, pointing at a realtime model (for example an Azure OpenAI
        <code>gpt-realtime</code> deployment), then reload this page.
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card">
                <div class="card-header"><i class="bi bi-sliders"></i> Session</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label" for="rt-deployment">Realtime deployment</label>
                        <select id="rt-deployment" class="form-select">
                            @foreach (var deployment in Model)
                            {
                                <option value="@deployment.Name">@deployment.Name (@deployment.ModelName — @deployment.ClientName)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="rt-voice">Voice</label>
                        <select id="rt-voice" class="form-select">
                            <option value="alloy">alloy</option>
                            <option value="ash">ash</option>
                            <option value="ballad">ballad</option>
                            <option value="coral">coral</option>
                            <option value="echo">echo</option>
                            <option value="sage">sage</option>
                            <option value="shimmer">shimmer</option>
                            <option value="verse">verse</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="rt-instructions">Instructions (system prompt)</label>
                        <textarea id="rt-instructions" class="form-control" rows="3">You are a friendly voice assistant. Keep your spoken answers short and conversational.</textarea>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button id="rt-start" type="button" class="btn btn-success"><i class="bi bi-mic-fill"></i> Start talking</button>
                        <button id="rt-stop" type="button" class="btn btn-outline-danger" disabled><i class="bi bi-stop-fill"></i> Stop</button>
                        <span id="rt-status" class="badge bg-secondary ms-auto">Idle</span>
                    </div>
                    <div class="form-text mt-2">
                        Use Chrome or Edge, allow microphone access, and use headphones to avoid echo. Server-side voice
                        activity detection decides when to respond — just start speaking.
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-7">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center">
                    <i class="bi bi-chat-dots"></i> <span class="ms-2">Transcript</span>
                    <button id="rt-clear" type="button" class="btn btn-sm btn-outline-secondary ms-auto">Clear</button>
                </div>
                <div id="rt-log" class="card-body" style="height: 420px; overflow-y: auto;"></div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/_content/CrestApps.AI.Resources/scripts/realtime-test.js"></script>
}

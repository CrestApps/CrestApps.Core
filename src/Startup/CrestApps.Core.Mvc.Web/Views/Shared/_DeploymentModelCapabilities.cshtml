@using CrestApps.Core.AI.Models
@using CrestApps.Core.Mvc.Web.Areas.AI.ViewModels
@model AIDeploymentViewModel

<div class="card mb-3">
    <div class="card-header">
        <h6 class="card-title mb-0"><i class="bi bi-sliders"></i> Model capabilities</h6>
    </div>
    <div class="card-body">
        <p class="text-muted small">
            Declare what the underlying model supports. Features are capabilities the model either has or does not have.
            Parameters are options an operator can configure on an AI profile, profile template, or chat interaction.
            Anything not declared here is never rendered in those editors and is never sent to the provider.
        </p>

        @if (Model.AvailableFeatures.Any())
        {
            <div class="mb-4">
                <label class="form-label fw-semibold">Trained features</label>
                <p class="text-muted small mb-2">Capabilities the underlying model was trained with. Only declared features are sent to the provider.</p>
                @foreach (var group in Model.AvailableFeatures.GroupBy(feature => feature.Category ?? "Trained Features"))
                {
                    <div class="mb-2">
                        <div class="text-uppercase text-muted small">@group.Key</div>
                        @foreach (var feature in group)
                        {
                            var isChecked = Model.SelectedFeatures?.Contains(feature.Name, StringComparer.OrdinalIgnoreCase) ?? false;
                            <div class="form-check">
                                <input id="SelectedFeatures_@feature.ElementId"
                                       name="SelectedFeatures"
                                       type="checkbox"
                                       value="@feature.Name"
                                       class="form-check-input"
                                       @(isChecked ? "checked" : "") />
                                <label class="form-check-label" for="SelectedFeatures_@feature.ElementId">
                                    @feature.DisplayName
                                    @if (!string.IsNullOrWhiteSpace(feature.Description))
                                    {
                                        <span class="text-muted small d-block">@feature.Description</span>
                                    }
                                </label>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        @if (Model.ModelParameters.Count > 0)
        {
            <label class="form-label fw-semibold">Model parameters</label>
            @for (var i = 0; i < Model.ModelParameters.Count; i++)
            {
                var parameter = Model.ModelParameters[i];
                var bodyId = $"modelParameterBody_{parameter.ElementId}";
                <div class="border rounded p-3 mb-2">
                    <input type="hidden" name="ModelParameters[@i].Name" value="@parameter.Name" />
                    <div class="form-check">
                        <input id="ModelParameters_@(parameter.ElementId)_IsSupported"
                               name="ModelParameters[@i].IsSupported"
                               type="checkbox"
                               value="true"
                               class="form-check-input model-parameter-toggle"
                               data-target="@bodyId"
                               @(parameter.IsSupported ? "checked" : "") />
                        <input type="hidden" name="ModelParameters[@i].IsSupported" value="false" />
                        <label class="form-check-label" for="ModelParameters_@(parameter.ElementId)_IsSupported">
                            @parameter.DisplayName
                            @if (!string.IsNullOrWhiteSpace(parameter.Description))
                            {
                                <span class="text-muted small d-block">@parameter.Description</span>
                            }
                        </label>
                    </div>
                    <div class="mt-3 @(parameter.IsSupported ? string.Empty : "d-none")" id="@bodyId">
                        @if (parameter.Kind == AIModelParameterKind.Choice && parameter.AvailableValues.Any())
                        {
                            <div class="row g-2">
                                <div class="col-md-7">
                                    <label class="form-label small" for="ModelParameters_@(parameter.ElementId)_SelectedAllowedValues">Supported values</label>
                                    <select id="ModelParameters_@(parameter.ElementId)_SelectedAllowedValues"
                                            name="ModelParameters[@i].SelectedAllowedValues"
                                            class="selectpicker"
                                            data-model-allowed-values
                                            multiple
                                            title="All registered values"
                                            data-live-search="true"
                                            size="@Math.Min(parameter.AvailableValues.Count(), 6)">
                                        @foreach (var option in parameter.AvailableValues)
                                        {
                                            var isSelected = parameter.SelectedAllowedValues?.Contains(option.Value, StringComparer.OrdinalIgnoreCase) ?? false;
                                            <option value="@option.Value" selected="@(isSelected ? "selected" : null)">@option.Text</option>
                                        }
                                    </select>
                                    <div class="form-text">Leave nothing selected to support every registered value.</div>
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label small" for="ModelParameters_@(parameter.ElementId)_DefaultValue">Default value</label>
                                    <select id="ModelParameters_@(parameter.ElementId)_DefaultValue"
                                            name="ModelParameters[@i].DefaultValue"
                                            class="form-select">
                                        <option value="">No default</option>
                                        @foreach (var option in parameter.AvailableValues)
                                        {
                                            <option value="@option.Value" selected="@(string.Equals(option.Value, parameter.DefaultValue, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@option.Text</option>
                                        }
                                    </select>
                                    <div class="form-text">Applied when an operator does not select a value.</div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="row g-2">
                                <div class="col-md-3">
                                    <label class="form-label small" for="ModelParameters_@(parameter.ElementId)_DefaultValue">Default value</label>
                                    <input id="ModelParameters_@(parameter.ElementId)_DefaultValue"
                                           name="ModelParameters[@i].DefaultValue"
                                           class="form-control"
                                           value="@parameter.DefaultValue" />
                                </div>
                                @if (parameter.Kind == AIModelParameterKind.Number || parameter.Kind == AIModelParameterKind.Integer)
                                {
                                    <div class="col-md-3">
                                        <label class="form-label small" for="ModelParameters_@(parameter.ElementId)_Minimum">Minimum</label>
                                        <input id="ModelParameters_@(parameter.ElementId)_Minimum"
                                               name="ModelParameters[@i].Minimum"
                                               type="number" step="any"
                                               class="form-control"
                                               value="@parameter.Minimum" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small" for="ModelParameters_@(parameter.ElementId)_Maximum">Maximum</label>
                                        <input id="ModelParameters_@(parameter.ElementId)_Maximum"
                                               name="ModelParameters[@i].Maximum"
                                               type="number" step="any"
                                               class="form-control"
                                               value="@parameter.Maximum" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small" for="ModelParameters_@(parameter.ElementId)_Step">Step</label>
                                        <input id="ModelParameters_@(parameter.ElementId)_Step"
                                               name="ModelParameters[@i].Step"
                                               type="number" step="any"
                                               class="form-control"
                                               value="@parameter.Step" />
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

<script>
    (function () {
        function init() {
            Array.prototype.forEach.call(document.querySelectorAll('.model-parameter-toggle'), function (toggle) {
                if (toggle.dataset.initialized === 'true') {
                    return;
                }

                toggle.dataset.initialized = 'true';

                toggle.addEventListener('change', function () {
                    var body = document.getElementById(toggle.getAttribute('data-target'));

                    if (body) {
                        body.classList.toggle('d-none', !toggle.checked);
                    }
                });
            });

            if (typeof window.Selectpicker === 'function') {
                Array.prototype.forEach.call(document.querySelectorAll('select[data-model-allowed-values]'), function (select) {
                    if (select.dataset.selectpicker === 'true') {
                        return;
                    }

                    select.dataset.selectpicker = 'true';
                    new window.Selectpicker(select, { liveSearch: true });
                });
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }
    })();
</script>

@using System.Text.Json
@using CrestApps.Core.AI.WebMcp
@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery

@*
    WebMCP for signed-in users. webmcp-polyfill.js installs the standard document.modelContext in browsers without
    native WebMCP; webmcp.js registers the AI tools selected in the WebMCP settings with it, and connects the AI chat to
    every tool the page exposes; webmcp-page-tools.js registers the tools that read the page and fill its forms.
    Anonymous visitors get nothing.
*@
@if (User.Identity?.IsAuthenticated == true)
{
    var tokens = Antiforgery.GetAndStoreTokens(Context);
    var configuration = new Dictionary<string, object>
    {
        ["toolsUrl"] = Url.Content($"~/{WebMcpConstants.DefaultRoutePrefix}/tools"),
        ["invokeUrlTemplate"] = Url.Content($"~/{WebMcpConstants.DefaultRoutePrefix}/tools/") + "{name}/invoke",
        ["antiforgeryHeaderName"] = tokens.HeaderName,
        ["antiforgeryToken"] = tokens.RequestToken,
        ["isAdmin"] = string.Equals(ViewContext.RouteData.Values["area"]?.ToString(), "Admin", StringComparison.OrdinalIgnoreCase),
    };

    <script type="application/json" id="@WebMcpConstants.ConfigurationElementId">@Html.Raw(JsonSerializer.Serialize(configuration))</script>
    <script src="~/_content/CrestApps.AI.WebMcp.Resources/scripts/webmcp-polyfill.js" asp-append-version="true"></script>
    <script src="~/_content/CrestApps.AI.WebMcp.Resources/scripts/webmcp.js" asp-append-version="true"></script>
    <script src="~/_content/CrestApps.AI.WebMcp.Resources/scripts/webmcp-page-tools.js" asp-append-version="true"></script>
}

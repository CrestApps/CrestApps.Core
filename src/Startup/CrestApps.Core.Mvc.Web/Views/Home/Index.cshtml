@{
    ViewData["Title"] = "Dashboard";
}

@if (!User.Identity?.IsAuthenticated ?? true)
{
    <div class="alert alert-warning mb-4">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <strong>Getting Started:</strong> <a asp-controller="Account" asp-action="Login">Sign in</a> to access the admin features and start using AI chat.
    </div>
}

<div class="card mb-4 border-primary">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="fa-solid fa-rocket"></i> Getting Started</h5>
    </div>
    <div class="card-body">
        <p class="mb-2">Follow these steps to start using AI features in your application:</p>
        <ol class="mb-3">
            <li><strong>Add an AI Connection</strong> — configure a connection to your AI provider (OpenAI, Azure OpenAI, Ollama, etc.).</li>
            <li><strong>Add an AI Deployment</strong> — map a model deployment (e.g., <code>gpt-4o-mini</code>) to your connection.</li>
            <li><strong>Start testing</strong> — open <strong>Chat Interactions</strong> first to validate your connection and deployment immediately, then create an <strong>AI Profile</strong> when you want reusable chat, agent, or orchestration behavior.</li>
        </ol>
        <div class="alert alert-secondary mb-0 py-2">
            <i class="fa-solid fa-circle-info"></i>
            <strong>Technical name</strong> — you'll see this field throughout the UI. It's an auto-generated, machine-friendly identifier (e.g., <code>MyOpenAIConnection</code>) used internally to reference entities. It is set once during creation and cannot be changed afterward.
        </div>
    </div>
</div>

<section class="mb-5">
        <h3 class="mb-3"><i class="fa-solid fa-gauge-high text-muted me-2"></i>Admin</h3>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
        <div class="col">
            <div class="card h-100 border-primary">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <i class="fa-solid fa-book fs-2 text-primary me-3"></i>
                        <h5 class="card-title mb-0">Articles</h5>
                    </div>
                    <p class="card-text">Manage the sample content this host stores, used to demonstrate indexing and retrieval.</p>
                    <a asp-area="Admin" asp-controller="Article" asp-action="Index" class="btn btn-primary text-white">
                        <i class="fa-solid fa-arrow-right"></i> Manage Articles
                    </a>
                </div>
            </div>
        </div>
        </div>
    </section>
    <section class="mb-5">
        <h3 class="mb-3"><i class="fa-solid fa-robot text-muted me-2"></i>Artificial Intelligence</h3>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
        <div class="col">
            <div class="card h-100 border-success">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <i class="fa-solid fa-plug fs-2 text-success me-3"></i>
                        <h5 class="card-title mb-0">AI Connections</h5>
                    </div>
                    <p class="card-text">Configure connections to AI providers (OpenAI, Azure OpenAI, Ollama, Azure AI Inference).</p>
                    <a asp-area="AI" asp-controller="AIConnection" asp-action="Index" class="btn btn-success text-white">
                        <i class="fa-solid fa-arrow-right"></i> Manage Connections
                    </a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 border-warning">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <i class="fa-solid fa-box fs-2 text-warning me-3"></i>
                        <h5 class="card-title mb-0">AI Deployments</h5>
                    </div>
                    <p class="card-text">Map model deployments to connections for fine-grained control over which models are used.</p>
                    <a asp-area="AI" asp-controller="AIDeployment" asp-action="Index" class="btn btn-warning">
                        <i class="fa-solid fa-arrow-right"></i> Manage Deployments
                    </a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 border-primary">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <i class="fa-solid fa-user-gear fs-2 text-primary me-3"></i>
                        <h5 class="card-title mb-0">AI Profiles</h5>
                    </div>
                    <p class="card-text">Create reusable AI behavior for chat, agents, tools, data sources, memory, and session processing.</p>
                    <a asp-area="AI" asp-controller="AIProfile" asp-action="Index" class="btn btn-primary text-white">
                        <i class="fa-solid fa-arrow-right"></i> Manage Profiles
                    </a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 border-info">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <i class="fa-solid fa-puzzle-piece fs-2 text-info me-3"></i>
                        <h5 class="card-title mb-0">AI Tool Instances</h5>
                    </div>
                    <p class="card-text">Configure reusable tool instances that AI profiles and agents can call during a conversation.</p>
                    <a asp-area="Tooling" asp-controller="AIToolInstance" asp-action="Index" class="btn btn-info text-white">
                        <i class="fa-solid fa-arrow-right"></i> Manage Tool Instances
                    </a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 border-danger">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <i class="fa-solid fa-comment-dots fs-2 text-danger me-3"></i>
                        <h5 class="card-title mb-0">Chat Interactions</h5>
                    </div>
                    <p class="card-text">The fastest way to test a new setup with a real conversation before creating reusable profiles.</p>
                    <a asp-area="ChatInteractions" asp-controller="ChatInteraction" asp-action="Index" class="btn btn-danger text-white">
                        <i class="fa-solid fa-arrow-right"></i> Open Chat
                    </a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 border-secondary">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <i class="fa-solid fa-file-lines fs-2 text-secondary me-3"></i>
                        <h5 class="card-title mb-0">Templates</h5>
                    </div>
                    <p class="card-text">Create reusable system prompt and profile templates for consistent AI behavior.</p>
                    <a asp-area="AI" asp-controller="AITemplate" asp-action="Index" class="btn btn-secondary text-white">
                        <i class="fa-solid fa-arrow-right"></i> Manage Templates
                    </a>
                </div>
            </div>
        </div>
        </div>
    </section>
    <section class="mb-5">
        <h3 class="mb-3"><i class="fa-solid fa-folder-tree text-muted me-2"></i>RAG</h3>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
        <div class="col">
            <div class="card h-100 border-success">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <i class="fa-solid fa-folder-tree fs-2 text-success me-3"></i>
                        <h5 class="card-title mb-0">File Sources</h5>
                    </div>
                    <p class="card-text">Read files from a local folder, an FTP server or an SFTP server into a File data source.</p>
                    <a asp-area="FileSources" asp-controller="FileSource" asp-action="Index" class="btn btn-success text-white">
                        <i class="fa-solid fa-arrow-right"></i> Manage File Sources
                    </a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 border-info">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <i class="fa-solid fa-globe fs-2 text-info me-3"></i>
                        <h5 class="card-title mb-0">Web Crawlers</h5>
                    </div>
                    <p class="card-text">Scrape websites into a Web data source, mapping many sites into one knowledge base for retrieval.</p>
                    <a asp-area="WebCrawlers" asp-controller="WebCrawler" asp-action="Index" class="btn btn-info text-white">
                        <i class="fa-solid fa-arrow-right"></i> Manage Web Crawlers
                    </a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 border-primary">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <i class="fa-solid fa-layer-group fs-2 text-primary me-3"></i>
                        <h5 class="card-title mb-0">Data Sources</h5>
                    </div>
                    <p class="card-text">Map existing search indexes to a knowledge base for AI-powered retrieval.</p>
                    <a asp-area="DataSources" asp-controller="AIDataSource" asp-action="Index" class="btn btn-primary text-white">
                        <i class="fa-solid fa-arrow-right"></i> Manage Data Sources
                    </a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 border-dark">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <i class="fa-solid fa-database fs-2 text-dark me-3"></i>
                        <h5 class="card-title mb-0">Index Profiles</h5>
                    </div>
                    <p class="card-text">Define search index profiles for Elasticsearch or Azure AI Search vector stores.</p>
                    <a asp-area="Indexing" asp-controller="IndexProfile" asp-action="Index" class="btn btn-dark text-white">
                        <i class="fa-solid fa-arrow-right"></i> Manage Index Profiles
                    </a>
                </div>
            </div>
        </div>
        </div>
    </section>
    <section class="mb-5">
        <h3 class="mb-3"><i class="fa-solid fa-chart-column text-muted me-2"></i>Reports</h3>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
        <div class="col">
            <div class="card h-100 border-success">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <i class="fa-solid fa-chart-column fs-2 text-success me-3"></i>
                        <h5 class="card-title mb-0">Chat Analytics</h5>
                    </div>
                    <p class="card-text">See how chat is being used across profiles, sessions and interactions.</p>
                    <a asp-area="AIChat" asp-controller="ChatAnalytics" asp-action="Index" class="btn btn-success text-white">
                        <i class="fa-solid fa-arrow-right"></i> Open Chat Analytics
                    </a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 border-warning">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <i class="fa-solid fa-chart-line fs-2 text-warning me-3"></i>
                        <h5 class="card-title mb-0">AI Usage Analytics</h5>
                    </div>
                    <p class="card-text">Track token usage and cost per deployment, so an expensive model is visible before the bill is.</p>
                    <a asp-area="AIChat" asp-controller="UsageAnalytics" asp-action="Index" class="btn btn-warning">
                        <i class="fa-solid fa-arrow-right"></i> Open Usage Analytics
                    </a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 border-secondary">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <i class="fa-solid fa-table fs-2 text-secondary me-3"></i>
                        <h5 class="card-title mb-0">Chat Extracted Data</h5>
                    </div>
                    <p class="card-text">Review the structured data extracted from conversations by data processing profiles.</p>
                    <a asp-area="AIChat" asp-controller="ChatExtractedData" asp-action="Index" class="btn btn-secondary text-white">
                        <i class="fa-solid fa-arrow-right"></i> Open Extracted Data
                    </a>
                </div>
            </div>
        </div>
        </div>
    </section>
    <section class="mb-5">
        <h3 class="mb-3"><i class="fa-solid fa-network-wired text-muted me-2"></i>Integrations</h3>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
        <div class="col">
            <div class="card h-100 border-info">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <i class="fa-solid fa-sitemap fs-2 text-info me-3"></i>
                        <h5 class="card-title mb-0">Agent to Agent Hosts</h5>
                    </div>
                    <p class="card-text">Manage remote A2A hosts and make their agents available to MVC orchestration.</p>
                    <a asp-area="A2A" asp-controller="A2AConnection" asp-action="Index" class="btn btn-info text-white">
                        <i class="fa-solid fa-arrow-right"></i> Manage A2A Hosts
                    </a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 border-primary">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <i class="fa-solid fa-network-wired fs-2 text-primary me-3"></i>
                        <h5 class="card-title mb-0">MCP Hosts</h5>
                    </div>
                    <p class="card-text">Configure remote SSE MCP servers and local stdio MCP tools for orchestration.</p>
                    <a asp-area="Mcp" asp-controller="McpConnection" asp-action="Index" class="btn btn-primary text-white">
                        <i class="fa-solid fa-arrow-right"></i> Manage MCP Hosts
                    </a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 border-secondary">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <i class="fa-solid fa-comment fs-2 text-secondary me-3"></i>
                        <h5 class="card-title mb-0">MCP Prompts</h5>
                    </div>
                    <p class="card-text">Define MCP prompts with optional arguments so external clients can discover reusable prompt templates.</p>
                    <a asp-area="Mcp" asp-controller="McpPrompt" asp-action="Index" class="btn btn-secondary text-white">
                        <i class="fa-solid fa-arrow-right"></i> Manage MCP Prompts
                    </a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 border-dark">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <i class="fa-solid fa-folder-open fs-2 text-dark me-3"></i>
                        <h5 class="card-title mb-0">MCP Resources</h5>
                    </div>
                    <p class="card-text">Register FTP and SFTP-backed MCP resources, including template-based URI patterns for dynamic resources.</p>
                    <a asp-area="Mcp" asp-controller="McpResource" asp-action="Index" class="btn btn-dark text-white">
                        <i class="fa-solid fa-arrow-right"></i> Manage MCP Resources
                    </a>
                </div>
            </div>
        </div>
        </div>
    </section>

@if (User.Identity?.IsAuthenticated ?? false)
{
    <div class="mt-5">
        <a asp-area="Admin" asp-controller="Settings" asp-action="Index" class="btn btn-outline-secondary">
            <i class="fa-solid fa-gear"></i> Open Settings
        </a>
    </div>
}

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.Core.AI.Documents.OpenXml</RootNamespace>
    <Title>CrestApps AI Documents OpenXml</Title>
    <Description>
			$(CrestAppsDescription)

			OpenXml document ingestion services for CrestApps AI documents.
		</Description>
    <PackageTags>$(PackageTags) ai openxml documents office docx xlsx pptx</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <InternalsVisibleTo Include="CrestApps.Core.Benchmarks" />
    <InternalsVisibleTo Include="CrestApps.Core.Tests" />
    <!-- The Word agent builds documents with the same styles, numbering and table writer as the Word writer. -->
    <InternalsVisibleTo Include="CrestApps.Core.AI.Documents.Word" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../CrestApps.Core.AI.Documents/CrestApps.Core.AI.Documents.csproj" />
  </ItemGroup>

</Project>

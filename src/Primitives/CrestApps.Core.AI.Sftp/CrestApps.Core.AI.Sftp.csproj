<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.Core.AI.Sftp</RootNamespace>
    <Title>CrestApps AI SFTP</Title>
    <Description>
      $(CrestAppsDescription)

      Everything SFTP: the ingestion connector a file source reads with, and the MCP resource type a model
      reads through. Both sides share one connection record, so they ship together.
    </Description>
    <PackageTags>$(PackageTags) ai sftp ssh indexing mcp resources connectors</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrestApps.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../CrestApps.Core.AI.FileSources/CrestApps.Core.AI.FileSources.csproj" />
    <ProjectReference Include="../CrestApps.Core.AI.Mcp/CrestApps.Core.AI.Mcp.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.Core.AI.Documents</RootNamespace>
    <Title>CrestApps AI Documents</Title>
    <Description>
      $(CrestAppsDescription)

      Document ingestion, processing, document RAG, and uploaded-document endpoint services for CrestApps AI.
      Framework-independent, usable in any ASP.NET Core application.
    </Description>
    <PackageTags>$(PackageTags) ai documents rag uploads ingestion processing</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates\Prompts\**\*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrestApps.Core.Tests" />
    <!-- The PDF agent ships next to the PDF writer and reuses the tabular workspace and the spreadsheet value
         formatting that the preview draws with, so a table taken from uploaded data reads the same in a PDF. -->
    <InternalsVisibleTo Include="CrestApps.Core.AI.Documents.Pdf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.DataIngestion" />
    <PackageReference Include="ZString" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Abstractions/CrestApps.Core.Abstractions/CrestApps.Core.Abstractions.csproj" />
    <ProjectReference Include="../CrestApps.Core.AI/CrestApps.Core.AI.csproj" />
    <ProjectReference Include="../CrestApps.Core.AI.Chat/CrestApps.Core.AI.Chat.csproj" />
    <ProjectReference Include="../CrestApps.Core.AI.Ingestion/CrestApps.Core.AI.Ingestion.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The presentation engine lays text out with the same measurer the slide preview uses, so a line breaks
         at the same word in the picture and in the exported deck, and it lays diagrams out with the shared
         composer. -->
    <InternalsVisibleTo Include="CrestApps.Core.AI.Documents.OpenXml" />
  </ItemGroup>
</Project>

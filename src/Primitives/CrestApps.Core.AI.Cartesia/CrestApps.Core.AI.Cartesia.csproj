<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.Core.AI.Cartesia</RootNamespace>
    <Title>CrestApps AI Cartesia Core</Title>
    <Description>
      $(CrestAppsDescription)

      Cartesia Sonic text-to-speech, Ink speech-to-text, voice library search and voice cloning for CrestApps AI services.
    </Description>
    <PackageTags>$(PackageTags) ai cartesia text-to-speech speech-to-text voice-cloning</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrestApps.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../CrestApps.Core.AI/CrestApps.Core.AI.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.Core.AI.ElevenLabs</RootNamespace>
    <Title>CrestApps AI ElevenLabs Core</Title>
    <Description>
      $(CrestAppsDescription)

      ElevenLabs text-to-speech, speech-to-text (Scribe), voice library search and voice cloning for CrestApps AI services.
    </Description>
    <PackageTags>$(PackageTags) ai elevenlabs text-to-speech speech-to-text voice-cloning</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrestApps.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../CrestApps.Core.AI/CrestApps.Core.AI.csproj" />
  </ItemGroup>

</Project>

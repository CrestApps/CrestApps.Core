<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.Core.AI.Documents.Pdf</RootNamespace>
    <Title>CrestApps AI Documents PDF</Title>
    <Description>
			$(CrestAppsDescription)

			PDF support for CrestApps AI documents: the PDF reader, the PDF writer behind generated files and tabular
			exports, and the system PDF agent that builds, edits, previews and analyses PDFs in a conversation.
		</Description>
    <PackageTags>$(PackageTags) ai pdf documents extraction agent</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates\Prompts\**\*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrestApps.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" />
    <PackageReference Include="PDFsharp-MigraDoc" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../CrestApps.Core.AI.Documents/CrestApps.Core.AI.Documents.csproj" />
    <ProjectReference Include="../CrestApps.Core.AI.Ingestion.Pdf/CrestApps.Core.AI.Ingestion.Pdf.csproj" />
  </ItemGroup>

</Project>

{
  "name": "crestapps.core",
  "private": true,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "workspaces": [
    "src/Resources/*"
  ],
  "scripts": {
    "build": "node .scripts/assets/cli.mjs build",
    "rebuild": "node .scripts/assets/cli.mjs build --force",
    "watch": "node .scripts/assets/cli.mjs watch",
    "clean": "node .scripts/assets/cli.mjs clean",
    "dry-run": "node .scripts/assets/cli.mjs dry-run",
    "lint": "eslint .",
    "check": "tsc -p tsconfig.json",
    "test:client": "playwright test",
    "test:unit": "node --test tests/realtime-client/chart-markers.test.js tests/realtime-client/citation-markers.test.js tests/realtime-client/figure-markers.test.js tests/realtime-client/gate-decision.test.js tests/realtime-client/test-registration.test.js tests/realtime-client/webmcp.test.js tests/realtime-client/webmcp-page-tools.test.js tests/realtime-client/antiforgery-header.test.js tests/realtime-client/image-allowlist.test.js tests/realtime-client/image-sanitizer.test.js tests/realtime-client/answer-config-attributes.test.js",
    "test:gate": "npm run test:unit",
    "test": "npm run test:unit && npm run test:client"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "dompurify": "^3.4.17",
    "eslint": "^10.12.0",
    "glob": "^14.0.3",
    "globals": "^17.13.0",
    "jsdom": "^31.0.0",
    "sass": "^1.102.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.2"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
}

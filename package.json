{
  "name": "crestapps.core",
  "private": true,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "workspaces": [
    "src/Resources/*"
  ],
  "scripts": {
    "build": "node .scripts/assets/cli.mjs build",
    "rebuild": "node .scripts/assets/cli.mjs build --force",
    "watch": "node .scripts/assets/cli.mjs watch",
    "clean": "node .scripts/assets/cli.mjs clean",
    "dry-run": "node .scripts/assets/cli.mjs dry-run",
    "test:client": "playwright test",
    "test:unit": "node --test tests/realtime-client/chart-markers.test.js tests/realtime-client/citation-markers.test.js tests/realtime-client/figure-markers.test.js tests/realtime-client/gate-decision.test.js tests/realtime-client/test-registration.test.js",
    "test:gate": "npm run test:unit",
    "test": "npm run test:unit && npm run test:client"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "glob": "^13.0.6",
    "sass": "^1.102.0",
    "vite": "^8.3.2"
  }
}
